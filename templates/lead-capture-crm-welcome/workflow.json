      "id": "1ead0000-0000-4000-8000-000000000013",
      "name": "Read Existing Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1800,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "notes": "Reads the CRM sheet once, to tell new leads from people you already know."
    },
    {
      "parameters": {
        "jsCode": "// Mark each lead as new or already in the sheet (matched on email).\n// Also de-duplicates leads that arrive twice in the same run.\nconst known = new Set(\n  $input.all().map(r => String(r.json['Email'] || '').trim().toLowerCase()).filter(Boolean)\n);\nreturn $('Lead').all().map((item, i) => {\n  const lead = item.json;\n  const isNew = !known.has(lead.email);\n  known.add(lead.email);\n  return { json: { ...lead, isNew }, pairedItem: { item: 0 } };\n});"
      },

    {
      "parameters": {
        "promptType": "define",
        "text": "=From: {{ $json.name }} <{{ $json.email }}>\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You read one incoming email for a freelancer or small business and decide whether it is a NEW SALES LEAD: a real person or company who may want to BUY the recipient's products or services (a quote request, a project inquiry, a question about prices or availability, a request for a call or demo, a referral of a potential client).\n\nNOT leads: vendors or agencies trying to sell to the recipient, recruiters, job applicants, newsletters and promotions, existing customers asking for support, invoices and receipts, personal mail, notifications, and spam or scams. When unsure, set is_lead to false or lower \"confidence\" (0 to 1).\n\nIf it is a lead, extract what the email actually says. Never invent details; use an empty string for anything not stated.\n- \"name\": the person's full name (from the signature or the From line).\n- \"email\": a contact address they ask you to use, if it differs from the sender's; otherwise an empty string.\n- \"company\", \"phone\": as written in the email or signature.\n- \"interest\": a short lowercase noun phrase for a sentence like \"Thanks for getting in touch about ___\", e.g. \"a new website for your bakery\", max 10 words, no quotes.\n- \"budget\", \"timeline\": as stated, e.g. \"around $5k\", \"by March\".\n- \"summary\": one or two sentences on what they want.\n- \"reason\": one sentence on why this is or is not a lead."
            }
          ]
        }
      },

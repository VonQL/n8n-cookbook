      "id": "1ead0000-0000-4000-8000-000000000003",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "notes": "Fill these in before the first run. The workflow stops with an error while myAddress, ownerEmail, signature or sheetId still say REPLACE_ME."
    },
    {
      "parameters": {
        "jsCode": "// Stop early with a clear message if Settings still holds the template placeholders.\n{\n  const s = $('Settings').first().json;\n  const unset = [\"myAddress\", \"ownerEmail\", \"signature\", \"sheetId\"].filter(k => !String(s[k] ?? '').trim() || String(s[k]).includes('REPLACE_ME'));\n  if (unset.length) {\n    throw new Error('Open the Settings node and fill in: ' + unset.join(', ') + '. They still contain REPLACE_ME placeholders.');\n  }\n}\n\n// Turn a form submission or a Gmail message into one common shape.\n// Email gets cheap rule checks first, so automated and bulk mail never costs an AI call.\nconst SETTINGS = ['ownerEmail', 'signature', 'sheetId', 'sheetName', 'welcomeSubject', 'replyWithin', 'bookingLink', 'minConfidence', 'leadLabelId'];\nconst isEmailAddress = v => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v);\n\nreturn $input.all().map(item => {\n  const m = item.json;\n  const s = {};\n  for (const k of SETTINGS) s[k] = m[k];\n\n  // Gmail messages have a threadId; form submissions don't.\n  if (!m.threadId) {\n    const email = String(m['Email'] || '').trim().toLowerCase();\n    const name = String(m['Name'] || '').trim();\n    return {\n      json: {\n        source: 'form',\n        email,\n        name,\n        company: String(m['Company'] || '').trim(),\n        phone: String(m['Phone'] || '').trim(),\n        message: String(m['How can we help?'] || '').trim().slice(0, 6000),\n        messageId: '',\n        threadId: '',\n        skipReason: isEmailAddress(email) ? '' : 'form email address is not valid',\n        ...s,\n      },\n    };\n  }\n\n  const headers = m.headers || {};\n  const h = key => String(headers[key] || '').toLowerCase();\n  const sender = (m.from && m.from.value && m.from.value[0]) || {};\n  const fromAddr = String(sender.address || '').toLowerCase();\n  const subject = m.subject || '';\n  const body = String(m.text || '').replace(/\\s+/g, ' ').trim().slice(0, 6000);\n\n  const automatedSender = /(no-?reply|do-?not-?reply|mailer-daemon|postmaster|notifications?@|newsletter|bounce)/i.test(fromAddr);\n  const autoSubmitted = h('auto-submitted');\n  const bulkHeaders =\n    Boolean(headers['list-unsubscribe']) ||\n    /(bulk|list|junk)/.test(h('precedence')) ||\n    (autoSubmitted !== '' && !/(^|:\\s*)no\\s*$/.test(autoSubmitted));\n  // A reply or forward is an existing conversation, not a new lead.\n  const isReply = /^\\s*(re|fwd?|aw)\\s*:/i.test(subject);\n  const isSelf = fromAddr === String(m.myAddress || '').toLowerCase();\n\n  let skipReason = '';\n  if (isSelf) skipReason = 'sent by me';\n  else if (automatedSender) skipReason = 'automated sender';\n  else if (bulkHeaders) skipReason = 'bulk or mailing-list headers';\n  else if (isReply) skipReason = 'reply in an existing conversation';\n\n  return {\n    json: {\n      source: 'email',\n      email: fromAddr,\n      name: sender.name || '',\n      company: '',\n      phone: '',\n      message: body,\n      subject,\n      messageId: m.id,\n      threadId: m.threadId,\n      skipReason,\n      ...s,\n    },\n  };\n});"
      },

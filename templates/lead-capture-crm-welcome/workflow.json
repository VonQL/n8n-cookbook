      "id": "1ead0000-0000-4000-8000-000000000011",
      "name": "Not a Lead",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1560,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build one lead record, whichever way it arrived.\nconst isEmailAddress = v => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v);\nconst now = $now.toFormat('yyyy-MM-dd HH:mm');\n\nreturn $input.all().map((item, i) => {\n  const p = $('Prepare Lead').itemMatching(i).json;\n  const ai = item.json.output; // only set for email leads\n  const lead = { ...p };\n  if (ai) {\n    const alt = String(ai.email || '').trim().toLowerCase();\n    lead.email = isEmailAddress(alt) ? alt : p.email;\n    lead.name = ai.name || p.name;\n    lead.company = ai.company || '';\n    lead.phone = ai.phone || '';\n    lead.interest = ai.interest || '';\n    lead.budget = ai.budget || '';\n    lead.timeline = ai.timeline || '';\n    lead.summary = ai.summary || '';\n  } else {\n    lead.interest = '';\n    lead.budget = '';\n    lead.timeline = '';\n    lead.summary = p.message.slice(0, 500);\n  }\n  lead.firstName = String(lead.name || '').split(/\\s+/)[0] || '';\n  lead.receivedAt = now;\n\n  // The welcome email, written here so it is easy to edit in one place.\n  lead.welcomeMessage = [\n    `Hi ${lead.firstName || 'there'},`,\n    '',\n    `Thanks for getting in touch${lead.interest ? ' about ' + lead.interest : ''}. I've received your message and will get back to you personally within ${p.replyWithin}.`,\n    ...(p.bookingLink ? ['', `If it's easier, you can book a short call at a time that suits you: ${p.bookingLink}`] : []),\n    '',\n    'Best regards,',\n    p.signature,\n  ].join('\\n');\n\n  return { json: lead, pairedItem: { item: i } };\n});"
      },

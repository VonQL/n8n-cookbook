    {
      "id": "3c9e0000-0000-4000-8000-000000000010",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -440
      ],
      "parameters": {
        "content": "## Form submissions to documents\nA form submission picks a Google Docs template (quote, contract or certificate), copies it, fills in the `{{placeholders}}`, exports a PDF and emails it.\n\nBy default the PDF goes **to you for review**. Set `sendToClient` to true to email the client directly (you're CC'd).\n\n1. Make the Google Docs templates (see README)\n2. Fill in **Settings**\n3. Connect Google Drive, Google Docs and Gmail credentials\n4. Open the form URL and submit a test",
        "height": 380,
        "width": 400
      }
    }

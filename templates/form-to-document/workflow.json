    {
      "id": "3c9e0000-0000-4000-8000-000000000003",
      "name": "Prepare Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Stop early with a clear message if Settings still holds the template placeholders.\nfunction checkSettings(s, keys) {\n  const unset = keys.filter(k => !String(s[k] ?? '').trim() || String(s[k]).includes('REPLACE_ME'));\n  if (unset.length) {\n    throw new Error('Open the Settings node and fill in: ' + unset.join(', ') + '. They still contain REPLACE_ME placeholders.');\n  }\n}\n\n// Pick the template for the chosen document type and prepare every placeholder value.\nconst s = $input.first().json;\nconst type = String(s['Document type'] || '').trim();\nconst templateKey = { Quote: 'quoteTemplateId', Contract: 'contractTemplateId', Certificate: 'certificateTemplateId' }[type];\nif (!templateKey) throw new Error('Unknown document type \"' + type + '\". Add it to the form and to this node.');\ncheckSettings(s, ['outputFolderId', 'myEmail', 'senderName', templateKey]);\n\nconst clean = v => String(v ?? '').replace(/\\s+/g, ' ').trim();\nconst clientName = clean(s['Client name']);\nconst clientEmail = clean(s['Client email']).toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(clientEmail)) throw new Error('Client email \"' + clientEmail + '\" is not a valid address.');\n\n// Document number like Q-20261122-7K3F: prefix, date, 4 random characters.\nconst prefix = { Quote: 'Q', Contract: 'C', Certificate: 'CERT' }[type];\nconst rand = Math.random().toString(36).slice(2, 6).toUpperCase();\nconst docNumber = `${prefix}-${DateTime.now().toFormat('yyyyLLdd')}-${rand}`;\n\nconst d = DateTime.fromISO(String(s['Date'] || ''));\nconst date = d.isValid ? d.toFormat('LLLL d, yyyy') : clean(s['Date']);\n\nlet amount = '';\nif (s['Amount'] !== undefined && s['Amount'] !== null && s['Amount'] !== '') {\n  const n = Number(s['Amount']);\n  try { amount = new Intl.NumberFormat('en-US', { style: 'currency', currency: s.currency || 'USD' }).format(n); }\n  catch (e) { amount = (s.currency || '') + ' ' + n.toFixed(2); }\n}\n\n// Placeholder -> value. Each {{name}} in the Google Docs template is replaced with its value.\n// Keep this list in sync with the Fill Placeholders node.\nconst values = {\n  doc_type: type,\n  doc_number: docNumber,\n  client_name: clientName,\n  client_email: clientEmail,\n  company: clean(s['Company']),\n  title: clean(s['Title']),\n  amount,\n  date,\n  details: String(s['Details'] || '').trim(),\n  today: DateTime.now().toFormat('LLLL d, yyyy'),\n  sender_name: s.senderName,\n};\n\nreturn [{\n  json: {\n    ...values,\n    templateId: s[templateKey],\n    outputFolderId: s.outputFolderId,\n    fileName: `${type} ${docNumber} - ${clientName}`.replace(/[\\\\/:*?\"<>|]/g, '-'),\n    myEmail: s.myEmail,\n    sendToClient: s.sendToClient === true || String(s.sendToClient).toLowerCase() === 'true',\n  },\n}];"
      }
    },
    {
      "id": "3c9e0000-0000-4000-8000-000000000004",

                  }
                ]
              }
            },
            {
              "fieldLabel": "Client name",
              "requiredField": true,
              "placeholder": "Ana Santos"
            },
            {
              "fieldLabel": "Client email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "placeholder": "Optional"
